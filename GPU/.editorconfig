# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,h,cpp,hpp,m}]
max_line_length = 80

[*.py]
indent_size = 4

[*.plist]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
